#!/bin/bash

# Find staged C++ source and header files (added/copied/modified, no deletes).
mapfile -d '' -t staged_files < <(git diff --cached --name-only -z --diff-filter=ACM -- \
    '*.cpp' '*.cc' '*.cxx' '*.h' '*.hpp')

if [ ${#staged_files[@]} -eq 0 ]; then
    exit 0
fi

failed_files=()
format_passed_files=()

# Check each file separately so only files that fail are unstaged.
echo "Running clang-format check on staged files..."
for file in "${staged_files[@]}"; do
    if clang-format --dry-run --Werror -- "$file"; then
        format_passed_files+=("$file")
    else
        echo "❌ Clang-format check failed: $file"
        failed_files+=("$file")
    fi
done

echo "Running clang-tidy on staged files..."

# Run clang-tidy. Assumes compile_commands.json is in your build directory.
# Map each staged *-inl.hpp to its owner header (X-inl.hpp -> X.hpp), but
# unstage the original file if the owner fails the check.
declare -A tidy_result=()
for file in "${format_passed_files[@]}"; do
    tidy_file="$file"
    if [[ "$file" == *-inl.hpp ]]; then
        owner="${file%-inl.hpp}.hpp"
        if [ -f "$owner" ]; then
            tidy_file="$owner"
        fi
    fi

    if [[ -z ${tidy_result["$tidy_file"]+set} ]]; then
        if clang-tidy -p build "$tidy_file" --warnings-as-errors='*'; then
            tidy_result["$tidy_file"]=0
        else
            tidy_result["$tidy_file"]=1
        fi
    fi

    if [ "${tidy_result["$tidy_file"]}" -ne 0 ]; then
        echo "❌ Clang-tidy check failed: $file"
        failed_files+=("$file")
    fi
done

if [ ${#failed_files[@]} -ne 0 ]; then
    git restore --staged -- "${failed_files[@]}" || exit 1
    echo "❌ Some checks failed. Failed files unstaged. Commit aborted."
    exit 1
fi

echo "✅ Clang-format and clang-tidy passed!"
exit 0
